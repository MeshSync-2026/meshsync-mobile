# MeshSync mobile — environment template
# Local:  cp .env.example .env  → npx expo start
# EAS build: the same keys are set per profile in eas.json → build.<profile>.env
# EXPO_PUBLIC_* values are embedded in the app bundle: URLs only, never secrets.

# Edge Sync base URL (POST /ingest, GET /sync). Local dev: use your PC's LAN IP, not localhost.
EXPO_PUBLIC_EDGE_SYNC_URL=http://192.168.1.10:4001

# Edge Sync WebSocket relay (Render: wss://<edge-host>/ws)
EXPO_PUBLIC_EDGE_SYNC_WS_URL=ws://192.168.1.10:4001/ws

# Command Center base URL (officer login + device registration)
EXPO_PUBLIC_CC_URL=http://192.168.1.10:4002
