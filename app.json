{
  "expo": {
    "name": "MeshSync",
    "slug": "meshsync",
    "version": "2.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.meshsync.app"
    },
    "android": {
      "package": "org.meshsync.app"
    },
    "plugins": [
      [
        "@config-plugins/react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow MeshSync to discover and sync with nearby emergency responders."
        }
      ]
    ]
  }
}
